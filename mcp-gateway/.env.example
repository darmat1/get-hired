# Copy to .env on the VPS (chmod 600). Never commit the real file.

# Required. Supabase pooler (port 6543) is fine — the pool runs without
# prepared statements.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Same value as in Vercel. Decrypts users' own AI keys (user_ai_key.key).
ENCRYPTION_KEY=

# Server AI keys — same names and values as in Vercel.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional, same meaning as in Vercel.
# AI_PROVIDER_ORDER=openrouter,gemini,groq,openai,claude
# GOOGLE_MODEL= GROQ_MODEL= OPENAI_MODEL= ANTHROPIC_MODEL=
# NEXT_PUBLIC_OPENROUTER_FREE_MODEL= NEXT_PUBLIC_APP_URL=https://gethired.work

# Next deployment, used only to render PDFs.
GETHIRED_BASE_URL=https://gethired.work

PORT=8080

# Emergency stop: every agent route returns 503, /healthz keeps working.
# AGENTS_DISABLED=1
